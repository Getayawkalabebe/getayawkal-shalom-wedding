{
  "name": "getayawkal-shalom-wedding",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "vercel-build": "npm run db:migrate && npm test && npm run build",
    "format": "node node_modules/prettier/bin/prettier.cjs --write app db lib scripts tests next.config.mjs",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check app db lib scripts tests next.config.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "next": "16.4.3",
    "postgres": "3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}